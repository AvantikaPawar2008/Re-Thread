# RE-THREAD Environment Variables — copy to .env and fill in values
# .env is NEVER committed to version control (see .gitignore)

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite for local dev. Swap for PostgreSQL in production.
DATABASE_URL=sqlite:///./rethread.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rethread_db

# ── VLM (Vision-Language Model) ──────────────────────────────────────────────
# Provider: "google" (Gemini) or "openai" (GPT-4o / GPT-4-vision)
VLM_PROVIDER=google
# Get a Gemini key at: https://aistudio.google.com/app/apikey
VLM_API_KEY=your_api_key_here
# Model names:
#   Google: gemini-2.0-flash  |  gemini-1.5-pro
#   OpenAI: gpt-4o            |  gpt-4-turbo
VLM_MODEL=gemini-2.0-flash
VLM_TIMEOUT_SECONDS=20.0

# ── ML Model Configuration ───────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.60
DEFAULT_GARMENT_WEIGHT_KG=0.30
RANKER_TYPE=xgboost

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# Leave as default for local development

