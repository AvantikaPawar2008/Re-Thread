# =============================================================================
# RE-THREAD: Git Ignore Rules (Clean Prototype Review)
# =============================================================================

# ── Secrets & Environment Variables (NEVER commit credentials) ───────────────
.env
.env*.local
*.env
*.pem
*.key

# ── Local SQLite Database & Cache ────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal

# ── Python Bytecode & Runtime Caches ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environments ──────────────────────────────────────────────────────
env/
venv/
ENV/
.venv/

# ── Testing, Profiling & Coverage ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# ── Node.js / Next.js Build Outputs ───────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.next/
frontend/out/

# ── Model Weights & Training Runs (Store weights externally) ──────────────────
weights/*.pt
weights/*.bin
weights/*.pth
weights/*.onnx
weights/*.joblib
weights/*.pkl
ml/runs/
ml/datasets/
wandb/

# ── Logs & Temporary Files ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp

# ── OS & IDE Clutter ──────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
